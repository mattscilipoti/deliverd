{
  "name": "deliverd (Go)",
  // Official Docker Hub "golang" image; the "latest" tag tracks the newest Go release.
  "image": "golang:latest",
  "features": {
    // Creates a non-root "vscode" user (the golang image only has root).
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "upgradePackages": false
    }
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "GOFLAGS": "-buildvcs=false",
    // Keep all Claude Code state (including ~/.claude.json) inside the persisted volume below.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "mounts": [
    // Persist module and build caches across container rebuilds.
    "source=deliverd-go-mod,target=/go/pkg,type=volume",
    "source=deliverd-go-cache,target=/home/vscode/.cache/go-build,type=volume",
    // Persist Claude Code login and settings across container rebuilds.
    "source=deliverd-claude-config,target=/home/vscode/.claude,type=volume",
    // Persist deliverd's saved loads (~/.config/deliverd/loads) across container rebuilds.
    "source=deliverd-saved-loads,target=/home/vscode/.config/deliverd,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /go /home/vscode/.cache /home/vscode/.claude /home/vscode/.config && go version && go install golang.org/x/tools/gopls@latest && go install github.com/go-delve/delve/cmd/dlv@latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "Anthropic.claude-code"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "go.useLanguageServer": true,
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  }
}
